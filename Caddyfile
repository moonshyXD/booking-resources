localhost {
    handle_path /iam* {
        reverse_proxy localhost:8006
    }

    handle_path /notifications* {
        reverse_proxy localhost:8010
    }

    handle_path /catalog* {
        reverse_proxy catalog:8013
    }

    handle /frontend/* {
        reverse_proxy localhost:8001
    }

    handle {
        respond "Route not found" 404
    }
}